{{!
    @template block_sharing_cart/block/content

    Example context (json):
    {"contextid":1,"canBackup":1,"canBackupUserdata":0,"canAnonymizeUserdata":0,"showSharingCartBasket":1,"courseContextId":1}
}}
<div id="block_sharing_cart" data-contextid="{{courseContextId}}" data-can-backup="{{canBackup}}">
    <div class="drop_here_text">
        <strong class="m-auto">{{#str}}drop_here, block_sharing_cart{{/str}}</strong>
    </div>
    <div class="block-content">
        <div class="mb-3 {{^showCopiesQueuedSegmentWhenEmpty}}d-none{{/showCopiesQueuedSegmentWhenEmpty}}">
            <h6 class="fw-bold mb-2 pb-2 border-bottom">
                {{#str}}restores, block_sharing_cart{{/str}}
            </h6>
            <div class="sharing_cart_queue">
                <i class="fa fa-spinner"></i>
            </div>
        </div>
        <div>
            <div class="d-flex align-items-center mb-2 pb-2 border-bottom">
                <h6 class="me-auto fw-bold mb-0">
                    {{#str}}items, block_sharing_cart{{/str}}
                </h6>
                <span role="button" class="user-select-none d-none" id="block_sharing_cart_cancel_bulk_delete">
                    <span class="me-1">{{#str}}cancel_bulk_delete, block_sharing_cart{{/str}}</span>
                </span>
                <span role="button" class="user-select-none {{^items.1}}d-none{{/items.1}}" id="block_sharing_cart_bulk_delete">
                    <span class="me-1">{{#str}}bulk_delete, block_sharing_cart{{/str}}</span><i class="fa fa-trash"></i>
                </span>
            </div>
            <div class="sharing_cart_items_wrapper">
                <div id="select_all_container" class="d-none">
                    <input type="checkbox" id="select_all_box" class="ms-2">
                    <label class="fw-bold ms-1" for="select_all_box" id="select_all_label">
                        {{#str}}select_all, block_sharing_cart{{/str}}
                    </label>
                </div>
                <div class="sharing_cart_items">
                    {{#items}}
                        {{> block_sharing_cart/block/item}}
                    {{/items}}

                    <div class="no-items mt-2 text-muted {{#items.0}}d-none{{/items.0}}">
                        {{#str}}no_items, block_sharing_cart{{/str}}
                    </div>
                    <div class="has-items mt-2 text-muted {{^items.0}}d-none{{/items.0}}">
                        {{#str}}has_items, block_sharing_cart{{/str}}
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-primary mt-3 w-100 d-none" id="block_sharing_cart_bulk_delete_confirm"
                    disabled>
                <span class="me-1">{{#str}}delete_marked_items, block_sharing_cart{{/str}}</span><i
                    class="fa fa-trash"></i>
            </button>
        </div>
        {{#showCopySectionInBlock}}
            {{#canBackup}}
                <div id="copy_section_container" class="mt-3">
                    <h6 class="fw-bold mb-2 pb-2 border-bottom">
                        {{#str}}backup_a_section, block_sharing_cart{{/str}}
                    </h6>
                    <select class="custom-select w-100">
                        <option disabled selected>{{#str}}choosedots, core{{/str}}</option>
                    </select>
                    <button type="button" class="btn btn-primary mt-3 w-100">{{#str}}copy_section, block_sharing_cart{{/str}}</button>
                </div>
            {{/canBackup}}
        {{/showCopySectionInBlock}}
    </div>
</div>
{{#js}}
    require(['block_sharing_cart/local/block'], function(component) {
    component.init(
    'block_sharing_cart',
    {{#canBackupUserdata}}1{{/canBackupUserdata}}{{^canBackupUserdata}}0{{/canBackupUserdata}},
    {{#canAnonymizeUserdata}}1{{/canAnonymizeUserdata}}{{^canAnonymizeUserdata}}0{{/canAnonymizeUserdata}},
    {{#canBackup}}1{{/canBackup}}{{^canBackup}}0{{/canBackup}},
    {{#showSharingCartBasket}}1{{/showSharingCartBasket}}{{^showSharingCartBasket}}0{{/showSharingCartBasket}},
    {{courseContextId}}
    );
    });
{{/js}}
